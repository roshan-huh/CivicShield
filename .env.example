GROQ_API_KEY=
OPENAI_API_KEY=                 # optional fallback
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=15
CORS_ORIGINS=http://localhost:8501
ENABLE_ATTACK_SIMULATOR=true    # set false in any non-demo deployment
REMEDIATION_MODE=simulate       # "simulate" (log only) or "live" (runs allow-listed iptables/logger)
API_BASE_URL=http://localhost:8000